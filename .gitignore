.DS_Store
__pycache__/

# Personal data — NEVER commit (public repo). CI gets these via Actions secrets.
candidate_profile.md
candidate_profile.json
run_local_triage.bat
resume.md
resume.txt
shortlist.*
website_extrator/
auto_apply/

# Sync service (sync/ deploys to Vercel from the CLI). GitHub Pages serves this
# repo's root, so anything committed here is published — keep credentials and
# dependencies out. .env* must be ignored BEFORE any `vercel env pull`.
sync/.env*
sync/.vercel/
node_modules/
# Vendor agent-docs the Upstash integration drops in on install — ~40 markdown
# files that aren't ours, get regenerated, and would be published by Pages.
sync/.agents/
sync/.claude/
sync/skills-lock.json

# Auto‑generated job data – keep them out of Git
all_jobs.json
companies.json
jobs.*
linkedin_jobs.*
scores.json
workflow_runs.jsonl
daily/*.json
daily/*.txt
Daily/*.json
Daily/*.txt
